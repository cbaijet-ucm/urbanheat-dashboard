{"version":1,"revision":120,"objects":[{"id":"object-1788652665497-1","type":"text","x":0,"y":10,"w":1626.75,"h":645.5,"html":"<p class=\"editor-text-block\"></p><p class=\"editor-text-block\"></p><span style=\"color: rgb(0, 0, 0);\"><ul style=\"\"><li style=\"\"><span style=\"color: rgb(0, 0, 0); font-weight: bold;\">Modelización predictiva</span><span style=\"color: rgb(0, 0, 0);\"><span style=\"font-weight: bold;\"> de LST</span> (Land Surface Temperature) mediante integración de fuentes de datos heterogéneas y </span><span style=\"color: rgb(0, 0, 0); font-weight: bold;\">Machine Learning</span></li><li style=\"\"><span style=\"color: rgb(0, 0, 0);\">Ámbito de estudio: </span><span style=\"color: rgb(0, 0, 0); font-weight: bold;\">Barcelona</span><span style=\"color: rgb(0, 0, 0);\"> + buffer 1km, periodo 2015-2026</span></li><li style=\"\"><span style=\"color: rgb(0, 0, 0);\">Doble enfoque: </span><span style=\"color: rgb(0, 0, 0); font-weight: bold;\">modelo tabular + deep learning (CNN)</span></li><li style=\"\"><span style=\"color: rgb(0, 0, 0);\">Capa análisis sociodemográfico</span></li><li style=\"\"><span style=\"color: rgb(0, 0, 0); font-weight: bold;\">Ciencia de Datos, no Climatología</span></li></ul></span><p></p>","style":{"fontFamily":"Helvetica","fontSize":44,"color":"#4532a4","background":"#ffffff","textAlign":"left","fontWeight":"normal","fontStyle":"normal","textDecoration":"none","lineHeight":"2"}}]}